# Axon Configuration
# Copy this file to .env and adjust the values as needed.

# Database
# Path to the KuzuDB directory. Defaults to .axon/kuzu inside the analyzed repository.
# AXON_DB_PATH=.axon/kuzu

# Embeddings
# The model to use for semantic code search.
# Supported models: "BAAI/bge-small-en-v1.5", "BAAI/bge-base-en-v1.5", etc.
AXON_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Ingestion Performance
# Number of threads to use for parallel file parsing.
# Defaults to 8. Set higher for powerful machines, lower for resource-constrained ones.
AXON_THREADS=8

# Logging
# Log level for the application.
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
AXON_LOG_LEVEL=INFO

# Batch Size
# Batch size for embedding generation.
# Defaults to 64. Reduce if you run out of memory.
AXON_BATCH_SIZE=64
